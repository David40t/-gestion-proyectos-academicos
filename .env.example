APP_NAME="Gestion de Proyectos Academicos"
APP_ENV=local
APP_KEY=
# En producción: APP_ENV=production y APP_DEBUG=false (oculta trazas y datos internos; se muestran las páginas de error propias).
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Motor: mysql (desarrollo). Para MariaDB cambiar a DB_CONNECTION=mariadb (ver docs/04, ADR-001)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_proyectos
DB_USERNAME=your_db_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Seguridad de sesión: contenido cifrado en BD; en producción con HTTPS usar además SESSION_SECURE_COOKIE=true.
SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: 'log' escribe los correos en storage/logs. Para Gmail: MAIL_MAILER=smtp, MAIL_SCHEME=smtp,
# MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=<tu cuenta> y MAIL_PASSWORD=<contraseña de aplicación>.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Solo desarrollo: redirige TODOS los correos a esta dirección (vacío en producción).
MAIL_TO_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
