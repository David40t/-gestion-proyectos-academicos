#==============================================================================
# Sistema de gestión y seguimiento de proyectos académicos
# Copiar a .env y completar. NUNCA versionar el archivo .env (contiene secretos).
# Configuración de producción recomendada: docs/07-seguridad.md §4
#==============================================================================

#------------------------------------------------------------------------------
# Aplicación
#------------------------------------------------------------------------------
APP_NAME="Gestion de Proyectos Academicos"
# local | production. Los datos demo solo se siembran en local/testing.
APP_ENV=local
# Se genera con: php artisan key:generate
APP_KEY=
# En producción: false (oculta trazas; se muestran las páginas de error propias).
APP_DEBUG=true
# URL base; se usa en los enlaces de los correos. Con https:// se activa HSTS.
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Costo del hash bcrypt de contraseñas.
BCRYPT_ROUNDS=12

#------------------------------------------------------------------------------
# Registro de errores (storage/logs/laravel.log)
#------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# En producción: warning
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Base de datos: MySQL 8 o MariaDB 10.6+ (ADR-001)
# Para MariaDB: DB_CONNECTION=mariadb. La base de datos debe existir previamente.
#------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestion_proyectos
DB_USERNAME=your_db_user
DB_PASSWORD=

#------------------------------------------------------------------------------
# Sesión (tabla "sessions")
#------------------------------------------------------------------------------
SESSION_DRIVER=database
# Minutos de inactividad antes de cerrar la sesión.
SESSION_LIFETIME=120
# Contenido de la sesión cifrado en BD.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS: true (la cookie solo viaja por HTTPS).
# SESSION_SECURE_COOKIE=true

#------------------------------------------------------------------------------
# Cola y caché: driver "database", sin Redis (ADR-008)
# Requiere un worker: php artisan queue:work
#------------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

#------------------------------------------------------------------------------
# Correo (notificaciones de eventos importantes)
#
# Opción 1 (sin envío real): MAIL_MAILER=log. Los correos se escriben en storage/logs.
# Opción 2 (Gmail):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME="tu-cuenta@gmail.com"
#   MAIL_PASSWORD="contraseña de aplicación de Google (16 letras, sin espacios)"
#------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# SOLO desarrollo: redirige TODOS los correos a esta dirección (los usuarios demo usan @demo.test).
# Dejar vacío en producción.
MAIL_TO_ADDRESS=
